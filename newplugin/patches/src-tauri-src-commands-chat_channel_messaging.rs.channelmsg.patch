+    /// Two enabled channels, one connected: the connected one delivers, the
+    /// disconnected one fails, and the outcome reports BOTH independently.
+    #[tokio::test]
+    async fn per_channel_failure_isolation() {
+        let db = test_helpers::fresh_in_memory_db().await;
+        let connected_id = seed_enabled_channel(&db).await;
+        let disconnected_id = seed_enabled_channel(&db).await;
+        let manager = ChatChannelManager::new();
+        let rec = Recorder::default();
+        connect_recording_channel(&manager, connected_id, &rec).await;
+
+        let messaging = messaging_with(&db, true, manager).await;
+        let outcome = messaging.send_message(request("hello")).await;
+
+        assert_eq!(outcome.total_sent, 1);
+        assert_eq!(outcome.total_targets, 2);
+        assert_eq!(outcome.per_channel.len(), 2);
+        let by_id = |id: i32| {
+            outcome
+                .per_channel
+                .iter()
+                .find(|r| r.channel_id == id)
+                .expect("per-channel result present")
+        };
+        assert!(by_id(connected_id).success);
+        assert_eq!(by_id(connected_id).sent_message_id.as_deref(), Some("1"));
+        assert!(!by_id(disconnected_id).success);
+        assert!(by_id(disconnected_id).error.is_some());
+
+        // Exactly one delivery, and one log row per targeted channel.
+        assert_eq!(rec.msgs.lock().await.len(), 1);
+        let rows = log_rows(&db).await;
+        assert_eq!(rows.len(), 2);
+        let statuses: Vec<&str> = rows.iter().map(|r| r.status.as_str()).collect();
+        assert!(statuses.contains(&"sent"));
+        assert!(statuses.contains(&"failed"));
+    }
+
+    /// Successful send persists one outbound `agent_send` log row carrying the
+    /// preview and the sent message id.
+    #[tokio::test]
+    async fn successful_send_persists_agent_send_log() {
+        let db = test_helpers::fresh_in_memory_db().await;
+        let channel_id = seed_enabled_channel(&db).await;
+        let manager = ChatChannelManager::new();
+        let rec = Recorder::default();
+        connect_recording_channel(&manager, channel_id, &rec).await;
+
+        let messaging = messaging_with(&db, true, manager).await;
+        let outcome = messaging.send_message(request("hello world")).await;
+
+        assert_eq!(outcome.total_sent, 1);
+        assert_eq!(outcome.per_channel[0].sent_message_id.as_deref(), Some("1"));
+        assert_eq!(rec.msgs.lock().await.clone(), vec!["hello world".to_string()]);
+
+        let rows = log_rows(&db).await;
+        assert_eq!(rows.len(), 1);
+        let row = &rows[0];
+        assert_eq!(row.channel_id, channel_id);
+        assert_eq!(row.direction, "outbound");
+        assert_eq!(row.message_type, "agent_send");
+        assert_eq!(row.status, "sent");
+        assert_eq!(row.content_preview, "hello world");
+        assert_eq!(row.error_detail, None);
+    }
+}
