+    /// Enabled in the DB but not connected in the manager: per-channel failure
+    /// with the manager's NotFound error, logged as failed.
+    #[tokio::test]
+    async fn enabled_but_disconnected_channel_reports_failure() {
+        let db = test_helpers::fresh_in_memory_db().await;
+        let channel_id = seed_enabled_channel(&db).await;
+        // NOTE: manager has NO connected backend for channel_id.
+        let manager = ChatChannelManager::new();
+        let rec = Recorder::default();
+
+        let messaging = messaging_with(&db, true, manager).await;
+        let outcome = messaging.send_message(request("hello")).await;
+
+        assert_eq!(outcome.total_sent, 0);
+        assert_eq!(outcome.total_targets, 1);
+        assert!(!outcome.per_channel[0].success);
+        assert_eq!(outcome.per_channel[0].channel_id, channel_id);
+        let err = outcome.per_channel[0].error.as_deref().unwrap_or("");
+        assert!(!err.is_empty(), "a per-channel error must be reported");
+        assert!(rec.msgs.lock().await.is_empty());
+
+        let rows = log_rows(&db).await;
+        assert_eq!(rows.len(), 1);
+        assert_eq!(rows[0].status, "failed");
+        assert_eq!(rows[0].channel_id, channel_id);
+        assert!(rows[0].error_detail.is_some());
+    }
