+    };
+    use crate::db::entities::chat_channel_message_log;
+    use crate::db::test_helpers;
+    use crate::web::event_bridge::WebEventBroadcaster;
+
+    /// Records the rendered plain text of every delivered message so tests can
+    /// assert exactly what was pushed (and that nothing was). Mirrors the
+    /// `RecordingBackend` pattern used by the chat_channel event_subscriber
+    /// tests, re-implemented here so the feature's tests never touch that
+    /// module.
+    #[derive(Clone, Default)]
+    struct Recorder {
+        msgs: Arc<tokio::sync::Mutex<Vec<String>>>,
+    }
+
+    struct RecordingBackend {
+        rec: Recorder,
+    }
+
+    #[async_trait]
+    impl ChatChannelBackend for RecordingBackend {
+        fn channel_type(&self) -> ChannelType {
+            ChannelType::Telegram
+        }
+
+        async fn start(&self, _tx: mpsc::Sender<IncomingCommand>) -> Result<(), ChatChannelError> {
+            Ok(())
+        }
+
+        async fn stop(&self) -> Result<(), ChatChannelError> {
+            Ok(())
+        }
+
+        async fn status(&self) -> ChannelConnectionStatus {
+            ChannelConnectionStatus::Connected
+        }
+
+        async fn send_message(&self, text: &str) -> Result<SentMessageId, ChatChannelError> {
+            self.rec.msgs.lock().await.push(text.to_string());
+            Ok(SentMessageId("1".into()))
+        }
+
+        async fn send_rich_message(
+            &self,
+            message: &RichMessage,
+        ) -> Result<SentMessageId, ChatChannelError> {
+            self.rec.msgs.lock().await.push(message.to_plain_text());
+            Ok(SentMessageId("1".into()))
+        }
+
+        async fn test_connection(&self) -> Result<(), ChatChannelError> {
+            Ok(())
+        }
+    }
+
+    /// Seed one ENABLED `chat_channel` row; returns its id.
+    async fn seed_enabled_channel(db: &crate::db::AppDatabase) -> i32 {
+        let model = chat_channel_service::create(
+            &db.conn,
+            "test-channel".to_string(),
+            "telegram".to_string(),
+            "{}".to_string(),
+            true,
+            false,
+            None,
+        )
+        .await
+        .expect("seed enabled channel");
+        model.id
+    }
+
+    /// Wire `id` into the manager as an ACTIVE (connected) recording backend.
+    async fn connect_recording_channel(manager: &ChatChannelManager, id: i32, rec: &Recorder) {
+        manager
+            .add_channel(
+                id,
+                format!("test-channel-{id}"),
+                ChannelType::Telegram,
+                Box::new(RecordingBackend { rec: rec.clone() }),
+            )
+            .await
+            .expect("wire connected backend");
+    }
+
+    /// Production impl wired to `db`'s connection, the given runtime flag, and
+    /// the given manager (whose ACTIVE channel set the caller controls).
+    async fn messaging_with(
+        db: &crate::db::AppDatabase,
+        enabled: bool,
+        manager: ChatChannelManager,
+    ) -> DbChannelMessaging {
+        let config = ChannelMessagingRuntimeConfig::new();
+        config.set(ChannelMessagingConfig { enabled }).await;
+        DbChannelMessaging::new(
+            Arc::new(crate::db::AppDatabase {
+                conn: db.conn.clone(),
+            }),
+            EventEmitter::test_web_only(Arc::new(WebEventBroadcaster::new())),
+            config,
+            manager,
+        )
+    }
+
+    fn request(message: &str) -> crate::acp::channel_messaging::SendChannelMessageRequest {
+        crate::acp::channel_messaging::SendChannelMessageRequest {
+            token: "test-token".to_string(),
+            message: message.to_string(),
+        }
+    }
+
+    async fn log_rows(db: &crate::db::AppDatabase) -> Vec<chat_channel_message_log::Model> {
+        chat_channel_message_log::Entity::find()
+            .all(&db.conn)
+            .await
+            .expect("read outbound message log")
+    }
+
+    #[test]
+    fn settings_into_runtime_config_flips_enabled() {
+        let off = ChannelMessagingSettings { enabled: false };
+        assert!(!off.into_runtime_config().enabled);
+        let on = ChannelMessagingSettings { enabled: true };
+        assert!(on.into_runtime_config().enabled);
+    }
+
+    /// ASCII body longer than the 200-char preview cap: the full message is
+    /// delivered exactly once, and the log preview is the first 200 chars.
+    #[tokio::test]
+    async fn ascii_message_delivers_full_and_logs_200_char_preview() {
+        let db = test_helpers::fresh_in_memory_db().await;
+        let channel_id = seed_enabled_channel(&db).await;
+        let manager = ChatChannelManager::new();
+        let rec = Recorder::default();
+        connect_recording_channel(&manager, channel_id, &rec).await;
+
+        let messaging = messaging_with(&db, true, manager).await;
+        let message = "a".repeat(250);
+        let outcome = messaging.send_message(request(&message)).await;
+
+        assert_eq!(outcome.total_sent, 1);
+        assert_eq!(outcome.total_targets, 1);
+        assert!(outcome.note.is_none());
+        assert_eq!(
+            rec.msgs.lock().await.clone(),
+            vec![message.clone()],
+            "the full message must be delivered exactly once"
+        );
+        assert!(outcome.per_channel[0].success);
+        assert_eq!(outcome.per_channel[0].sent_message_id.as_deref(), Some("1"));
+
+        let rows = log_rows(&db).await;
+        assert_eq!(rows.len(), 1);
+        assert_eq!(rows[0].direction, "outbound");
+        assert_eq!(rows[0].message_type, "agent_send");
+        assert_eq!(rows[0].status, "sent");
+        assert_eq!(rows[0].content_preview, "a".repeat(200));
+        assert_eq!(rows[0].error_detail, None);
+    }
+
+    /// Regression test for the byte-indexed preview slice panic: a multibyte
+    /// message whose byte length exceeds 200 and whose 200th byte is NOT a char
+    /// boundary (67 CJK chars = 201 bytes) used to panic with "byte index 200 is
+    /// not a char boundary" AFTER the send, losing the response and risking a
+    /// duplicate delivery. Must complete, deliver the full message, and log a
+    /// char-boundary-safe preview.
+    #[tokio::test]
+    async fn multibyte_message_over_200_bytes_does_not_panic() {
+        let db = test_helpers::fresh_in_memory_db().await;
+        let channel_id = seed_enabled_channel(&db).await;
+        let manager = ChatChannelManager::new();
+        let rec = Recorder::default();
+        connect_recording_channel(&manager, channel_id, &rec).await;
+
+        let messaging = messaging_with(&db, true, manager).await;
+        // 70 CJK chars = 210 bytes; byte 200 falls inside char #67.
+        let message = "好".repeat(70);
+        let outcome = messaging.send_message(request(&message)).await;
+
+        assert_eq!(outcome.total_sent, 1);
+        assert_eq!(
+            rec.msgs.lock().await.clone(),
+            vec![message.clone()],
+            "the full message must be delivered exactly once"
+        );
+
+        let rows = log_rows(&db).await;
+        assert_eq!(rows.len(), 1);
+        assert_eq!(rows[0].status, "sent");
+        // preview = truncate_chars(msg, 200) = 200 chars -> log service caps at
+        // 200 BYTES on a char boundary (66 x 3-byte chars = 198 bytes) and
+        // appends the ellipsis marker.
+        assert_eq!(rows[0].content_preview, format!("{}...", "好".repeat(66)));
+    }
+
+    /// Emoji (4-byte) + CJK (3-byte) mixed body: same boundary hazard as the
+    /// pure-CJK case - the 200th byte lands inside a multi-byte char.
+    #[tokio::test]
+    async fn emoji_cjk_mixed_message_does_not_panic() {
+        let db = test_helpers::fresh_in_memory_db().await;
+        let channel_id = seed_enabled_channel(&db).await;
+        let manager = ChatChannelManager::new();
+        let rec = Recorder::default();
+        connect_recording_channel(&manager, channel_id, &rec).await;
+
+        let messaging = messaging_with(&db, true, manager).await;
+        // 30 x 4-byte emoji + 30 x 3-byte CJK = 210 bytes; byte 200 is a
+        // continuation byte of the 27th CJK char.
+        let message = "👋".repeat(30) + &"你".repeat(30);
+        let outcome = messaging.send_message(request(&message)).await;
+
+        assert_eq!(outcome.total_sent, 1);
+        assert_eq!(
+            rec.msgs.lock().await.clone(),
+            vec![message.clone()],
+            "the full message must be delivered exactly once"
+        );
+        let rows = log_rows(&db).await;
+        assert_eq!(rows.len(), 1);
+        assert_eq!(rows[0].status, "sent");
+        // 120 bytes of emoji + 78 bytes of CJK = 198 bytes on a char boundary,
+        // then the ellipsis marker - never a panic mid-char.
+        assert_eq!(
+            rows[0].content_preview,
+            format!("{}...", "👋".repeat(30) + &"你".repeat(26))
+        );
+    }
+
+    /// A message at the 4096-char limit (12 KiB of multibyte text) is delivered
+    /// un-truncated - the char cap is exclusive.
+    #[tokio::test]
+    async fn message_at_4096_char_limit_delivers_unchanged() {
+        let db = test_helpers::fresh_in_memory_db().await;
+        let channel_id = seed_enabled_channel(&db).await;
+        let manager = ChatChannelManager::new();
+        let rec = Recorder::default();
+        connect_recording_channel(&manager, channel_id, &rec).await;
+
+        let messaging = messaging_with(&db, true, manager).await;
+        let message = "界".repeat(MAX_CHANNEL_MESSAGE_CHARS);
+        let outcome = messaging.send_message(request(&message)).await;
+
+        assert_eq!(outcome.total_sent, 1);
+        let recorded = rec.msgs.lock().await.clone();
+        assert_eq!(recorded.len(), 1);
+        assert_eq!(recorded[0].chars().count(), MAX_CHANNEL_MESSAGE_CHARS);
+        assert_eq!(recorded[0], message);
+
+        let rows = log_rows(&db).await;
+        assert_eq!(rows.len(), 1);
+        assert_eq!(rows[0].status, "sent");
+        // 66 x 3-byte chars = 198 bytes on a char boundary, then the marker.
+        assert_eq!(rows[0].content_preview, format!("{}...", "界".repeat(66)));
+    }
