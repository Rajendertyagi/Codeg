+//! `send_channel_message` backing logic + settings persistence.
+//!
+//! Two surfaces live here, mirroring `crate::commands::chat_authoring`:
+//!
+//!   * [`DbChannelMessaging`] — the production [`ChannelMessageAccess`] impl the
+//!     delegation listener calls when a chat agent asks codeg to send a message
+//!     into the user's connected channels. It re-checks the feature flag,
+//!     truncates the message, iterates enabled channels, sends via
+//!     [`crate::chat_channel::ChatChannelManager`], and logs each attempt.
+//!   * The `chat_channel_messaging.enabled` setting knob (**default false**) —
+//!     read at MCP injection time via [`ChannelMessagingRuntimeConfig`] to build
+//!     `--features`, and AGAIN at call time by [`DbChannelMessaging`] so
+//!     turning the switch off stops sends from sessions that were launched
+//!     while it was on.
+
+use std::sync::Arc;
+
+use async_trait::async_trait;
+use sea_orm::DatabaseConnection;
+use serde::{Deserialize, Serialize};
+
+use crate::acp::channel_messaging::{
+    ChannelMessageAccess, ChannelMessageOutcome, ChannelMessagingConfig, ChannelMessagingRuntimeConfig,
+    MAX_CHANNEL_MESSAGE_CHARS,
+};
+use crate::acp::chat_authoring::truncate_chars;
+use crate::app_error::AppCommandError;
+use crate::chat_channel::{types::RichMessage, ChatChannelManager};
+use crate::commands::chat_authoring::{load_flag, CHAT_AUTHORING_SETTINGS_CHANGED_EVENT};
+use crate::db::service::{
+    chat_channel_message_log_service, chat_channel_service,
+};
+use crate::db::AppDatabase;
+use crate::web::event_bridge::{emit_event, EventEmitter};
+
+const KEY_CHANNEL_MESSAGING_ENABLED: &str = "chat_channel_messaging.enabled";
+
+/// Production [`ChannelMessageAccess`]. Holds the DB, the event emitter (unused
+/// here — no state-change broadcast needed), the runtime config it re-checks
+/// before every send, and the chat-channel manager that does the actual dispatch.
+pub struct DbChannelMessaging {
+    pub db: Arc<AppDatabase>,
+    pub emitter: EventEmitter,
+    pub config: ChannelMessagingRuntimeConfig,
+    pub chat_channel_manager: ChatChannelManager,
+}
+
+impl DbChannelMessaging {
+    pub fn new(
+        db: Arc<AppDatabase>,
+        emitter: EventEmitter,
+        config: ChannelMessagingRuntimeConfig,
+        chat_channel_manager: ChatChannelManager,
+    ) -> Self {
+        Self {
+            db,
+            emitter,
+            config,
+            chat_channel_manager,
+        }
+    }
+}
+
+#[async_trait]
+impl ChannelMessageAccess for DbChannelMessaging {
+    async fn send_message(
+        &self,
+        req: crate::acp::channel_messaging::SendChannelMessageRequest,
+    ) -> ChannelMessageOutcome {
+        // Re-check at call time, not just at injection: a session launched while
+        // the switch was on keeps the tool listed after the user turns it off,
+        // and "off" has to stop the send.
+        if !self.config.enabled().await {
+            return ChannelMessageOutcome::rejected(
+                "Sending messages through chat channels is turned off in codeg's settings \
+                 (Settings → General → AI Channel Messaging). Ask the user to enable it.",
+            );
+        }
+
+        let conn = &self.db.conn;
+
+        // Resolve the native enabled-channel destination set — the same set every
+        // automatic outbound producer (event_subscriber, daily-report scheduler) uses.
+        let enabled_channels = match chat_channel_service::list_enabled(conn).await {
+            Ok(channels) => channels,
+            Err(e) => {
+                tracing::error!("[channel_messaging] failed to list enabled channels: {e}");
+                return ChannelMessageOutcome::rejected(format!("Could not resolve destination channels: {e}"));
+            }
+        };
+
+        if enabled_channels.is_empty() {
+            return ChannelMessageOutcome::no_channels();
+        }
+
+        // Truncate silently to Telegram's 4096-char limit (char-counted, not
+        // byte-counted, so multi-byte text is never split mid-codepoint).
+        let message = truncate_chars(&req.message, MAX_CHANNEL_MESSAGE_CHARS);
+        let mut per_channel = Vec::with_capacity(enabled_channels.len());
+
+        for ch in &enabled_channels {
+            let rich_msg = RichMessage::info(message.clone());
+            match self.chat_channel_manager.send_to_channel(ch.id, &rich_msg).await {
+                Ok(sent_id) => {
+                    let id_str = sent_id.0;
+                    let preview = &message[..message.len().min(200)];
+                    let _ = chat_channel_message_log_service::create_log(
+                        conn,
+                        ch.id,
+                        "outbound",
+                        "agent_send",
+                        preview,
+                        "sent",
+                        None,
+                    )
+                    .await;
+                    per_channel.push(ChannelSendResult {
+                        channel_id: ch.id,
+                        success: true,
+                        sent_message_id: Some(id_str),
+                        error: None,
+                    });
+                }
+                Err(e) => {
+                    tracing::warn!(
+                        "[channel_messaging] send_to_channel(ch={}) failed: {e}",
+                        ch.id
+                    );
+                    let preview = &message[..message.len().min(200)];
+                    let _ = chat_channel_message_log_service::create_log(
+                        conn,
+                        ch.id,
+                        "outbound",
+                        "agent_send",
+                        preview,
+                        "failed",
+                        Some(e.to_string()),
+                    )
+                    .await;
+                    per_channel.push(ChannelSendResult {
+                        channel_id: ch.id,
+                        success: false,
+                        sent_message_id: None,
+                        error: Some(e.to_string()),
+                    });
+                }
+            }
+        }
+
+        Ok(ChannelMessageOutcome::sent(enabled_channels.len(), per_channel))
+    }
+}
+
+// Settings persistence — `chat_channel_messaging.enabled` (default OFF).
+// Mirrors `crate::commands::chat_authoring`.
+// ===========================================================================
+
+#[derive(Debug, Clone, Default, Serialize, Deserialize, PartialEq, Eq)]
+pub struct ChannelMessagingSettings {
+    pub enabled: bool,
+}
+
+impl ChannelMessagingSettings {
+    fn into_runtime_config(self) -> ChannelMessagingConfig {
+        ChannelMessagingConfig {
+            enabled: self.enabled,
+        }
+    }
+}
+
+pub async fn load_channel_messaging_settings(
+    conn: &DatabaseConnection,
+) -> ChannelMessagingSettings {
+    ChannelMessagingSettings {
+        enabled: load_flag(conn, KEY_CHANNEL_MESSAGING_ENABLED).await,
+    }
+}
+
+pub async fn apply_persisted_channel_messaging_config(
+    conn: &DatabaseConnection,
+    config: &ChannelMessagingRuntimeConfig,
+) {
+    let settings = load_channel_messaging_settings(conn).await;
+    config.set(settings.into_runtime_config()).await;
+}
+
+pub async fn set_chat_channel_messaging_settings_core(
+    conn: &DatabaseConnection,
+    config: &ChannelMessagingRuntimeConfig,
+    emitter: &EventEmitter,
+    desired: ChannelMessagingSettings,
+) -> Result<ChannelMessagingSettings, AppCommandError> {
+    app_metadata_service::upsert_value(
+        conn,
+        KEY_CHANNEL_MESSAGING_ENABLED,
+        &desired.enabled.to_string(),
+    )
+    .await
+    .map_err(AppCommandError::from)?;
+    config.set(desired.clone().into_runtime_config()).await;
+    emit_event(emitter, CHAT_AUTHORING_SETTINGS_CHANGED_EVENT, &desired);
+    Ok(desired)
+}
+
+// -------- Tauri commands -----------------------------------------------------
+
+#[cfg_attr(feature = "tauri-runtime", tauri::command)]
+pub async fn get_chat_channel_messaging_settings(
+    #[cfg(feature = "tauri-runtime")] db: tauri::State<'_, crate::db::AppDatabase>,
+) -> Result<ChannelMessagingSettings, AppCommandError> {
+    #[cfg(feature = "tauri-runtime")]
+    {
+        Ok(load_channel_messaging_settings(&db.conn).await)
+    }
+    #[cfg(not(feature = "tauri-runtime"))]
+    {
+        Err(AppCommandError::configuration_invalid("tauri-only command"))
+    }
+}
+
+#[cfg_attr(feature = "tauri-runtime", tauri::command)]
+pub async fn set_chat_channel_messaging_settings(
+    #[cfg(feature = "tauri-runtime")] app: tauri::AppHandle,
+    #[cfg(feature = "tauri-runtime")] db: tauri::State<'_, crate::db::AppDatabase>,
+    #[cfg(feature = "tauri-runtime")] config: tauri::State<'_, ChannelMessagingRuntimeConfig>,
+    settings: ChannelMessagingSettings,
+) -> Result<ChannelMessagingSettings, AppCommandError> {
+    #[cfg(feature = "tauri-runtime")]
+    {
+        let emitter = EventEmitter::Tauri(app);
+        set_chat_channel_messaging_settings_core(&db.conn, &config, &emitter, settings).await
+    }
+    #[cfg(not(feature = "tauri-runtime"))]
+    {
+        let _ = settings;
+        Err(AppCommandError::configuration_invalid("tauri-only command"))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn settings_into_runtime_config_flips_enabled() {
+        let off = ChannelMessagingSettings { enabled: false };
+        assert!(!off.into_runtime_config().enabled);
+        let on = ChannelMessagingSettings { enabled: true };
+        assert!(on.into_runtime_config().enabled);
+    }
+}
