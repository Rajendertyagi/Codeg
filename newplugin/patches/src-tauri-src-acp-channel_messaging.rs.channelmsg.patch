+//! Channel-messaging domain types — backing the `send_channel_message` MCP tool.
+//!
+//! An AI agent (interactive or automation) can explicitly send a plain-text
+//! message into the user's already-connected/enabled chat channels (Telegram,
+//! Lark, Weixin). This module holds the layer-shared pieces:
+//!
+//!   * [`SendChannelMessageRequest`] — the validated request the companion
+//!     parsed out of the tool arguments.
+//!   * [`ChannelMessageOutcome`] (+ [`ChannelSendResult`]) — the result
+//!     delivered back over the broker socket, rendered by the companion.
+//!   * [`ChannelMessageAccess`] — the listener-facing trait the production
+//!     `DbChannelMessaging` (in `crate::commands::chat_channel_messaging`)
+//!     implements. Kept as a trait so tests can stub it.
+//!   * [`ChannelMessagingConfig`] + [`ChannelMessagingRuntimeConfig`] — the
+//!     hot-swappable "is the feature on?" flag, read BOTH at MCP injection
+//!     time and again at call time (mirrors
+//!     [`crate::acp::chat_authoring::ChatAuthoringRuntimeConfig`]).
+
+use std::sync::Arc;
+
+use async_trait::async_trait;
+use serde::{Deserialize, Serialize};
+use tokio::sync::RwLock;
+
+use super::chat_authoring::truncate_chars;
+
+/// Cap on an outbound channel message. Mirrors Telegram's 4096-char limit;
+/// truncated silently (no error to the LLM) — the LLM sees whatever was
+/// actually delivered.
+pub const MAX_CHANNEL_MESSAGE_CHARS: usize = 4096;
+
+/// A validated `send_channel_message` request. The companion has already
+/// checked the required string is non-empty; ranges are re-checked by the
+/// production impl.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct SendChannelMessageRequest {
+    pub token: String,
+    pub message: String,
+}
+
+/// Per-channel delivery result collected by [`DbChannelMessaging::send_message`].
+#[derive(Debug, Clone, Default, Serialize, Deserialize)]
+pub struct ChannelSendResult {
+    pub channel_id: i32,
+    pub success: bool,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub sent_message_id: Option<String>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub error: Option<String>,
+}
+
+/// The outcome handed back to the tool. A refusal (`total_sent == 0`) is a
+/// soft result carrying a `note` the LLM reads and can act on — never a tool
+/// error, so a disabled feature or an empty channel set doesn't derail the
+/// turn. On success, `per_channel` reports each channel's outcome so the LLM
+/// can confirm delivery when the user has multiple enabled channels.
+#[derive(Debug, Clone, Default, Serialize, Deserialize)]
+pub struct ChannelMessageOutcome {
+    pub total_sent: usize,
+    pub total_targets: usize,
+    #[serde(skip_serializing_if = "Vec::is_empty")]
+    pub per_channel: Vec<ChannelSendResult>,
+    /// Why it was refused, or an advisory on a successful send.
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub note: Option<String>,
+}
+
+impl ChannelMessageOutcome {
+    /// A soft refusal: nothing was sent, and `note` explains why in terms the
+    /// LLM can act on (turn the setting on, enable a channel, etc.).
+    pub fn rejected(note: impl Into<String>) -> Self {
+        Self {
+            total_sent: 0,
+            total_targets: 0,
+            note: Some(note.into()),
+            ..Default::default()
+        }
+    }
+
+    /// No enabled channels exist — nothing to send to.
+    pub fn no_channels() -> Self {
+        Self {
+            total_sent: 0,
+            total_targets: 0,
+            note: Some("No enabled chat channels are connected. Ask the user to enable a channel in Settings → Channels.".to_string()),
+            ..Default::default()
+        }
+    }
+
+    /// Success path: zero or more channels were targeted, `total_sent` of them
+    /// delivered. `per_channel` carries each result.
+    pub fn sent(total_targets: usize, per_channel: Vec<ChannelSendResult>) -> Self {
+        let total_sent = per_channel.iter().filter(|r| r.success).count();
+        Self {
+            total_sent,
+            total_targets,
+            per_channel,
+            ..Default::default()
+        }
+    }
+}
+
+/// Listener-facing access for the channel-messaging tool. The production impl
+/// (`crate::commands::chat_channel_messaging::DbChannelMessaging`) re-checks
+/// the feature flag at call time, resolves the enabled-channel destination set,
+/// truncates the message, and sends via [`crate::chat_channel::ChatChannelManager`].
+#[async_trait]
+pub trait ChannelMessageAccess: Send + Sync {
+    /// Send a plain-text message to every enabled channel. Returns a soft
+    /// outcome (never throws) so the companion can render the result without
+    /// a tool error.
+    async fn send_message(
+        &self,
+        req: SendChannelMessageRequest,
+    ) -> ChannelMessageOutcome;
+}
+
+/// The single feature flag. Default OFF: unlike the read-only `get_session_info`
+/// / `ask_user_question` tools, this sends messages into the user's external
+/// channels, so the user opts in explicitly.
+#[derive(Debug, Clone, Default, PartialEq, Eq)]
+pub struct ChannelMessagingConfig {
+    pub enabled: bool,
+}
+
+/// Shared, hot-swappable handle to [`ChannelMessagingConfig`]. Cloned into
+/// `DelegationInjection` (read at injection, to build `--features`) and into
+/// `AppState` (updated on save).
+///
+/// It is ALSO read again at call time by the production access impl. The
+/// read-only tools get away with an injection-time-only check — their tools
+/// stay listed for the life of an already-running session after the user flips
+/// the setting off. For a tool that sends messages externally, "off" has to
+/// mean off right now, so the write path re-reads this handle.
+#[derive(Clone, Default)]
+pub struct ChannelMessagingRuntimeConfig {
+    inner: Arc<RwLock<ChannelMessagingConfig>>,
+}
+
+impl ChannelMessagingRuntimeConfig {
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    pub async fn snapshot(&self) -> ChannelMessagingConfig {
+        self.inner.read().await.clone()
+    }
+
+    pub async fn set(&self, cfg: ChannelMessagingConfig) {
+        *self.inner.write().await = cfg;
+    }
+
+    pub async fn enabled(&self) -> bool {
+        self.inner.read().await.enabled
+    }
+}
